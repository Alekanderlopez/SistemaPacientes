</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3"><NavLink class="nav-link" href="" Match="NavLinkMatch.All">Inicio</NavLink></div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="pacientes">Pacientes</NavLink></div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="medicos">Médicos</NavLink></div>
